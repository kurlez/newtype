{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "newtype",
  "version": "0.1.0",
  "identifier": "app.newtype.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "newtype",
        "width": 480,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "AI voice input",
    "longDescription": "newtype is a menu-bar voice input app. This build is the shell and the updater.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNDk2NkY3RDNFREM0OTkKUldTWnhPM1Q5MlpKSXNkRmkrMGRNanpTNnkvbUF6Wk52NGo3YUVvNng1Wkhud1RPUDZheFpjZ0IK",
      "endpoints": [
        "https://github.com/kurlez/newtype-releases/releases/download/dev/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
