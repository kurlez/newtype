{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "newtype",
  "version": "0.2.0",
  "identifier": "app.newtype.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "newtype",
        "width": 560,
        "height": 860,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "transparent": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true,
    "shortDescription": "AI voice input",
    "longDescription": "newtype is a menu-bar voice input app. Cloud dictation is the default. Local Qwen speech and rewrite models download when you choose them.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODM4OTUwRDExRTNERjIKUldUeVBSN1JVSW1EUHpEclJaQ0N6U2JsMkxtdm1Ja0RiUmZlQ1VIdHdudUNDNnlZTlNRWlloWGwK",
      "endpoints": [
        "https://github.com/kurlez/newtype-releases/releases/download/dev/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
