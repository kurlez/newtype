{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window for the newtype shell.",
  "windows": ["main", "indicator"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "allow-get-state",
    "allow-set-channel",
    "allow-check-for-updates",
    "allow-apply-update",
    "allow-pipeline-status",
    "allow-dictation-snapshot",
    "allow-dictation-save",
    "allow-dictation-set-key",
    "allow-dictation-clear-key",
    "allow-dictation-test-connection",
    "allow-dictation-list-models",
    "allow-dictation-request-access",
    "allow-dictation-open-privacy",
    "allow-dictation-capture-hotkey",
    "allow-dictation-cancel-capture",
    "allow-dictation-record-toggle",
    "allow-dictation-cancel",
    "allow-dictation-history",
    "allow-dictation-delete-history",
    "allow-dictation-copy-history",
    "allow-dictation-microphones",
    "allow-dictation-probe-microphone",
    "allow-dictation-reset-models"
  ]
}
