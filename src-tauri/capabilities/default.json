{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window for the newtype shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "allow-get-state",
    "allow-set-channel",
    "allow-check-for-updates",
    "allow-apply-update",
    "allow-pipeline-status"
  ]
}
