    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
